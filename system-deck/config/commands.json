            "400",
            "--no-pager",
            "--no-hostname"
          ],
          "requires": [
            "journalctl"
          ],
          "timeout_s": 20
        },
        {
          "name": "📦 Paketintegrität",
          "description": "dpkg --audit meldet nur, es repariert nichts",
          "type": "READ",
          "cmd": "dpkg --audit",
          "argv": [
            "dpkg",
            "--audit"
          ],
          "requires": [
            "dpkg"
          ]
        },
        {
          "name": "⏱ Boot-Dauer",
          "description": "Systemd-Analyse der Boot-Zeiten",
          "type": "READ",
          "cmd": "systemd-analyze blame",
          "argv": [
            "systemd-analyze",
            "blame"
          ],
          "requires": [
            "systemd-analyze"
          ]
        },
        {
          "name": "🗺 Boot-Kritisch",
          "description": "Kritische Pfade des letzten Boots",
          "type": "READ",
          "cmd": "systemd-analyze critical-chain",
          "argv": [
            "systemd-analyze",
            "critical-chain"
          ],
          "requires": [
            "systemd-analyze"
          ]
        },
        {
          "name": "🔌 USB-Fehler (dmesg)",
          "description": "Kernelmeldungen zu USB und Hardwarefehlern",
          "type": "READ",
          "cmd": "journalctl -k -b -p warning -n 400 --no-pager --no-hostname",
          "argv": [
            "journalctl",
            "-k",
            "-b",
            "-p",
            "warning",
            "-n",
            "400",
            "--no-pager",
            "--no-hostname"
          ],
          "requires": [
            "journalctl"
          ],
          "timeout_s": 20
        },
        {
          "name": "🔋 Firmware / BIOS",
          "description": "Verfügbare Firmware-Updates - nur Abfrage, keine Installation",
          "type": "TERM",
          "sudo": true,
          "cmd": "sudo fwupdmgr get-devices",
          "requires": [
            "fwupdmgr"
          ],
          "package": "fwupd"
        },
        {
          "name": "📄 Bericht kopieren",
          "description": "Kopiert den kompletten Systemstatus als Text (rein lesend)",
          "type": "COPY",
          "cmd": "uname -a; lsb_release -a; uptime; free -h; df -hT; lsblk; systemctl --failed; ip -brief address; sensors"
        }
      ]
    }
