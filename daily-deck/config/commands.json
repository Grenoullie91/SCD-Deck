{
  "_readme": [
    "DAILY DECK - Befehlsliste. Nur diese Datei bearbeiten, niemals den Code.",
    "Nach dem Speichern im Deck F5 druecken oder Rechtsklick -> 'Neu laden'.",
    "",
    "FELDER EINER ENTRY:",
    "  name         Anzeigename (mit Icon)",
    "  description  Kurzbeschreibung / Tooltip-Zeile",
    "  type         START | TERMINAL | COPY   (Pflicht, bestimmt die Aktion)",
    "  argv         nur bei START: Argumentliste, z.B. [\"nemo\", \"~\"]",
    "  command      TERMINAL: Befehl, der im Terminal laeuft",
    "               COPY:     Text, der kopiert wird",
    "  workdir      TERMINAL: Arbeitsverzeichnis, z.B. \"~/Downloads\"",
    "  copy_text    optionaler eigener Text fuer COPY",
    "  requires     Programme, die installiert sein muessen (Pruefung)",
    "  enabled      false = Eintrag ausblenden",
    "",
    "SICHERHEIT: destruktive Befehle (rm -rf, sudo, mkfs, shutdown, ...)",
    "werden vom Programm abgewiesen und sind nicht ausfuehrbar.",
    "Es wird NIE ein Passwort und NIE ein SSH-Key gespeichert.",
    "SSH-Hosts werden automatisch aus ~/.ssh/config gelesen und hier",
    "absichtlich NICHT dupliziert."
  ],

  "settings": {
    "ssh_workdir": "~",
    "default_terminal_fallback": ""
  },

  "categories": {
    "START": {
      "icon": "🚀",
      "order": 10,
      "entries": [
        {
          "name": "🖥 Terminal öffnen",
          "description": "Standard-Terminal im Home-Verzeichnis",
          "type": "TERMINAL",
          "workdir": "~"
        },
        {
          "name": "🖥 Terminal · sauber",
          "description": "Terminal im Home, Bildschirm geleert",
          "type": "TERMINAL",
          "workdir": "~",
          "command": "clear"
        },
        {
          "name": "📂 Nemo",
          "description": "Dateimanager im Home-Verzeichnis",
          "type": "START",
          "argv": ["nemo", "~"],
          "requires": ["nemo"]
        },
        {
          "name": "🟣 CS Matrix",
          "description": "cmatrix - Digital Rain im Terminal",
          "type": "TERMINAL",
          "workdir": "~",
          "command": "cmatrix",
          "requires": ["cmatrix"]
        },
        {
          "name": "🎵 Musik · Rhythmbox",
          "description": "Musikplayer starten",
          "type": "START",
          "argv": ["rhythmbox"],
          "requires": ["rhythmbox"]
        },
        {
          "name": "✉ Thunderbird",
          "description": "E-Mail-Client starten",
          "type": "START",
          "argv": ["thunderbird"],
          "requires": ["thunderbird"]
        }
      ]
    },

