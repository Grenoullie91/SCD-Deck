    "SERVER": {
      "icon": "🌐",
      "order": 30,
      "entries": [
        {
          "name": "⏏ SSH verlassen",
          "description": "kopiert 'exit' - im SSH-Fenster einfügen (Strg+Shift+V) + Enter",
          "type": "COPY",
          "command": "exit",
          "copy_text": "exit"
        },
        {
          "name": "🌐 SSH-Verbindung prüfen",
          "description": "kopiert: ssh -v  (Alias aus ~/.ssh/config anhängen)",
          "type": "COPY",
          "command": "ssh -v",
          "copy_text": "ssh -v"
        },
        {
          "name": "📜 SSH-Aliase anzeigen",
          "description": "kopiert: grep -E '^Host ' ~/.ssh/config",
          "type": "COPY",
          "command": "grep -E '^Host ' ~/.ssh/config",
          "copy_text": "grep -E '^Host ' ~/.ssh/config"
        }
      ]
    },

    "TERMINAL": {
      "icon": "⌨",
      "order": 40,
      "entries": [
        {
          "name": "⬆ cd ..",
          "description": "eine Ebene höher (in bestehender Shell einfügen)",
