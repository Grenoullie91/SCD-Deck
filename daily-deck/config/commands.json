          "command": "neofetch",
          "requires": ["neofetch"]
        },
        {
          "name": "💽 Speicherplatz",
          "description": "kopiert: df -h",
          "type": "COPY",
          "command": "df -h",
          "copy_text": "df -h"
        },
        {
          "name": "🧠 Arbeitsspeicher",
          "description": "kopiert: free -h",
          "type": "COPY",
          "command": "free -h",
          "copy_text": "free -h"
        },
        {
          "name": "⚙ Top-Prozesse",
          "description": "kopiert: 15 speicherhungrigste Prozesse",
          "type": "COPY",
          "command": "ps aux --sort=-%mem | head -n 15",
          "copy_text": "ps aux --sort=-%mem | head -n 15"
